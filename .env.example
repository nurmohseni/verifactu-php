#############################################
#          PRODUCTION CONFIG (AEAT)         #
#############################################

# Path to your certificate (P12/PFX)
VERIFACTU_CERT_PATH=/path/to/your/certificate.p12
# Certificate password
VERIFACTU_CERT_PASSWORD=your_certificate_password
# Certificate type: 'certificate' or 'seal'
VERIFACTU_CERT_TYPE=certificate
# Environment: 'production' or 'sandbox'
VERIFACTU_ENVIRONMENT=production

#############################################
#            SANDBOX / TESTS CONFIG         #
#############################################

# Path to your certificate (P12/PFX) for sandbox
# VERIFACTU_CERT_PATH=/path/to/your/certificate.p12
# Certificate password for sandbox
# VERIFACTU_CERT_PASSWORD=your_certificate_password
# Certificate type: 'certificate' or 'seal'
# VERIFACTU_CERT_TYPE=certificate
# Environment for sandbox
# VERIFACTU_ENVIRONMENT=sandbox

# Required by integration tests (must match AEAT census data)
TEST_ISSUER_NIF=B12345678
TEST_ISSUER_NAME="Example Company SL"

#############################################
#     VNIFV2 CENSUS VALIDATION (AEAT)       #
#############################################

# The VNifV2 web service (WS Masivo de Calidad de Datos Identificativos)
# verifies whether a NIF and name/company name match the AEAT census. It
# reuses the certificate configured above (VERIFACTU_CERT_PATH, etc.) and
# requires no extra credentials — only mutual TLS, no XAdES signature.
#
# AEAT only documents a production endpoint for VNifV2 (no sandbox). The
# endpoint is selected automatically from VERIFACTU_CERT_TYPE
# (www1 for 'certificate', www10 for 'seal'). To override it (e.g. for a
# future sandbox URL), call Verifactu::setVnifEndpoint($url) after config().
#
# The integration tests (tests/Verifactu/CensusValidationSandboxTest.php) reuse
# TEST_ISSUER_NIF / TEST_ISSUER_NAME as a known census pair when set; otherwise
# they fall back to a NIF used in AEAT documentation examples.
